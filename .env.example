# Copy this file to ".env" and fill in real values:   cp .env.example .env
# ".env" is git-ignored. NEVER commit real secrets. Do not wrap values in quotes
# (this file is read as Java properties, so quotes would become part of the value).
# On Render, set these same names as Environment Variables in the dashboard instead.
# Values marked "optional" have a safe default and can be left out.

# =====================================================================
# REQUIRED - the app will not start without these
# =====================================================================

# --- Database (Supabase Postgres) ---
# Use the Supabase *pooler* connection string (session mode, port 5432) and keep sslmode=require, e.g.
# jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://your-host:5432/postgres?sslmode=require
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=change-me

# --- Auth ---
# Long random string. Generate one with:  openssl rand -base64 64
JWT_SECRET=change-me-to-a-long-random-string

# =====================================================================
# CORS - which frontend may call this API from a browser
# =====================================================================
# Your deployed frontend, WITHOUT a trailing slash. "*" is not allowed.
FRONTEND_URL=https://your-frontend.example.com
# optional: more origins, comma separated. Wildcard sub domains are fine: https://*.vercel.app
CORS_ALLOWED_ORIGINS=
# optional (default true): allow http://localhost:* for local development. Set false in production if unused.
CORS_ALLOW_LOCALHOST=true

# =====================================================================
# FILE STORAGE
# =====================================================================
# local     = "uploads" folder on this machine (development only; Render wipes it on every deploy)
# supabase  = Supabase Storage bucket (use this in production)
STORAGE_TYPE=local

# Needed only when STORAGE_TYPE=supabase
# Project URL, e.g. https://abcdefghijklmnop.supabase.co   (Supabase -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
# SERVICE-ROLE (secret) key. Backend only! It bypasses Row Level Security. Never put it in the frontend.
SUPABASE_STORAGE_API_KEY=change-me-service-role-key
# Name of a bucket you created in the Supabase dashboard (Storage -> New bucket)
SUPABASE_STORAGE_BUCKET_NAME=platemate-uploads
# optional (default false): true only if the bucket is marked Public. Keep false for a private bucket.
SUPABASE_STORAGE_PUBLIC=false

# =====================================================================
# EMAIL (OTP mails)
# =====================================================================
# smtp    = Gmail / any SMTP server (local development; Render Free BLOCKS SMTP)
# resend  = Resend HTTPS API (verify a sending domain first)
# brevo   = Brevo HTTPS API (validate a sender first)
# console = print the email to the log, send nothing (development only)
EMAIL_PROVIDER=smtp

# For resend / brevo
EMAIL_API_KEY=change-me-provider-api-key
# Must be an address/domain that is verified at your provider, e.g. noreply@your-domain.com
EMAIL_FROM=noreply@your-domain.com
# optional display name
EMAIL_FROM_NAME=Mess Management System

# For EMAIL_PROVIDER=smtp (Gmail address + 16-character Google "App password", not your normal password)
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# =====================================================================
# LOGGING (optional) - leave at the defaults in production
# =====================================================================
# SHOW_SQL=false
# LOG_LEVEL_APP=INFO
# LOG_LEVEL_SQL=INFO
# LOG_LEVEL_SQL_BINDINGS=INFO   # TRACE prints query values (OTPs, hashes). Never in production.
